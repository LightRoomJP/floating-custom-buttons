{
  "manifest_version": 3,
  "name": "グラブル Custom Buttons",
  "version": "1.2.0",
  "description": "グラブルの画面上に、最大10個のカスタムボタンを自由配置し、配置プリセットと更新通知を利用できます。",
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://api.github.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Custom Buttons の設定",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://game.granbluefantasy.jp/*"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
