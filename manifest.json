{
  "manifest_version": 3,
  "name": "Floating Custom Buttons",
  "version": "2.1.0",
  "description": "Webページ上に最大10個のカスタムボタンを自由配置し、配置プリセットと更新通知を利用できます。",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "activeTab",
    "sidePanel"
  ],
  "host_permissions": [
    "https://api.github.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Floating Custom Buttons のサイドパネルを開く",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
